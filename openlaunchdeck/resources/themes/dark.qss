QMainWindow, QDialog, QWidget {
  background: #101317;
  color: #e7e9ed;
  font-family: "Segoe UI";
  font-size: 10pt;
}

QLabel {
  background: transparent;
}

QWidget#MainSurface {
  background: #0a0c0f;
}

QFrame#AppHeader {
  background: #12161b;
  border: 1px solid #272d35;
  border-radius: 7px;
}

QWidget#HeaderBrand, QWidget#HeaderMeta {
  background: transparent;
}

QFrame#HeaderActions {
  background: transparent;
  border: none;
}

QWidget#SidebarPanel, QFrame#DeckPanel, QWidget#InspectorPanel {
  background: #12161b;
  border: 1px solid #272d35;
  border-radius: 7px;
}

QScrollArea#InspectorScroll {
  background: transparent;
  border: none;
}

QScrollArea#SidebarScroll, QScrollArea#GridScroll {
  background: transparent;
  border: none;
}

QScrollArea#InspectorScroll > QWidget > QWidget {
  background: #12161b;
}

QScrollArea#SidebarScroll > QWidget > QWidget {
  background: transparent;
}

QSplitter#WorkspaceSplitter::handle {
  background: transparent;
  width: 8px;
}

QSplitter#WorkspaceSplitter::handle:hover {
  background: #313842;
  border-radius: 4px;
}

QLabel#HeaderTitle {
  color: #fafafa;
  font-size: 15pt;
  font-weight: 800;
}

QLabel#HeaderSubtitle, QLabel#PanelHint {
  color: #89919c;
  font-size: 8pt;
}

QLabel#HeaderActiveDeck {
  color: #d7dbe1;
  font-size: 9pt;
  font-weight: 800;
}

QLabel#HeaderModeChip {
  background: #1b2027;
  border: 1px solid #353d47;
  border-radius: 7px;
  color: #dce1e7;
  font-size: 8pt;
  font-weight: 800;
  padding: 4px 9px;
}

QLabel#HeaderModeChip[state="simulation"] {
  background: #251f13;
  border-color: #6b5524;
  color: #facc15;
}

QLabel#HeaderModeChip[state="connected"] {
  background: #10231b;
  border-color: #2f7d55;
  color: #6ee7b7;
}

QLabel#PanelTitle {
  color: #f4f5f7;
  font-size: 13pt;
  font-weight: 800;
}

QLabel#SectionTitle {
  color: #70d7ca;
  font-size: 9pt;
  font-weight: 800;
  margin-top: 8px;
  text-transform: uppercase;
}

QLabel#FieldLabel {
  color: #a6adb7;
  font-size: 9pt;
  font-weight: 700;
}

QLabel#HotkeyPreview {
  color: #70d7ca;
  font-size: 9pt;
  font-weight: 700;
  padding: 1px 2px 0 2px;
}

QCheckBox#HotkeyModifier {
  color: #d7dbe1;
  font-size: 9pt;
  spacing: 5px;
}

QMenuBar {
  background: #0d0f12;
  color: #dfe2e7;
  border-bottom: 1px solid #24292f;
  padding: 3px 8px;
}

QMenuBar::item {
  background: transparent;
  border-radius: 6px;
  padding: 5px 10px;
}

QMenuBar::item:selected, QMenu::item:selected {
  background: #252b32;
}

QMenu {
  background: #15191e;
  color: #e8eaed;
  border: 1px solid #303741;
  padding: 6px;
}

QMenu::item {
  border-radius: 5px;
  padding: 7px 22px;
}

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QListWidget, QTableWidget {
  background: #0c0f13;
  color: #f2f3f5;
  border: 1px solid #323943;
  border-radius: 6px;
  padding: 7px 9px;
  selection-background-color: #2563eb;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTableWidget:focus {
  border: 1px solid #4fd1c5;
}
QPlainTextEdit[invalid="true"] { border: 1px solid #ef4444; }

QLabel#ActionDescription, QLabel#MutedText {
  color: #9199a4;
  font-size: 9pt;
}

QTabBar::tab {
  background: #151a20;
  border: 1px solid #303740;
  color: #aeb5bf;
  padding: 8px 16px;
}

QTabBar::tab:selected {
  background: #20262d;
  color: #ffffff;
  border-bottom-color: #20262d;
}

QTableWidget {
  gridline-color: #242b33;
  alternate-background-color: #12171c;
}

QHeaderView::section {
  background: #191f25;
  border: none;
  border-bottom: 1px solid #353d47;
  color: #cbd1d8;
  font-weight: 700;
  padding: 7px 8px;
}

QPushButton {
  background: #1c2229;
  border: 1px solid #353d47;
  border-radius: 6px;
  color: #eef0f3;
  font-weight: 700;
  padding: 8px 12px;
}

QPushButton:hover {
  background: #252c34;
  border-color: #515c69;
}

QPushButton:pressed {
  background: #14181d;
}

QPushButton#PrimaryButton {
  background: #0ea5a4;
  border-color: #2dd4bf;
  color: #041316;
}

QPushButton#PrimaryButton:hover {
  background: #22c7bd;
}

QPushButton#SecondaryButton, QPushButton#HeaderButton {
  background: #191e24;
  border-color: #303740;
  color: #dfe2e6;
}

QPushButton#HeaderButton {
  border-radius: 6px;
  padding: 6px 9px;
}

QPushButton#SecondaryButton:hover, QPushButton#HeaderButton:hover {
  background: #252c34;
}

QPushButton#HeaderPrimaryButton {
  background: #0f766e;
  border: 1px solid #2dd4bf;
  border-radius: 7px;
  color: #ecfeff;
  font-weight: 800;
  padding: 7px 10px;
}

QPushButton#HeaderPrimaryButton:hover {
  background: #0d9488;
}

QPushButton#HeaderPrimaryButton:pressed {
  background: #115e59;
}

QCheckBox {
  spacing: 8px;
}

QCheckBox::indicator {
  width: 17px;
  height: 17px;
  border-radius: 5px;
  border: 1px solid #4c5663;
  background: #0c0f13;
}

QCheckBox::indicator:checked {
  background: #22c55e;
  border-color: #4ade80;
}

QStatusBar {
  background: #0d0f12;
  color: #aeb5bf;
  border-top: 1px solid #24292f;
}

QStatusBar QLabel {
  background: transparent;
  color: #aeb5bf;
  padding: 0 6px;
}

QScrollBar:vertical, QScrollBar:horizontal {
  background: transparent;
  border: none;
  margin: 0;
}

QScrollBar:vertical {
  width: 10px;
}

QScrollBar:horizontal {
  height: 10px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: #3a424c;
  border-radius: 5px;
  min-height: 24px;
  min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
  background: #555f6b;
}

QToolTip {
  background: #20262d;
  color: #f4f5f7;
  border: 1px solid #3b444f;
  padding: 5px 7px;
}

QScrollBar::add-line, QScrollBar::sub-line {
  width: 0;
  height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
  background: transparent;
}
