QMainWindow, QDialog {
  background: @BACKGROUND@;
  color: @TEXT@;
  font-family: "@FONT_FAMILY@";
  font-size: 10pt;
}

QWidget {
  color: @TEXT@;
  font-family: "@FONT_FAMILY@";
  font-size: 10pt;
}

QWidget:disabled {
  color: @PLACEHOLDER@;
}

QLabel {
  background: transparent;
}

QWidget#MainSurface {
  background: @BACKGROUND@;
}

QFrame#AppHeader {
  background: @SURFACE@;
  border: none;
  border-bottom: 1px solid @BORDER@;
  border-radius: 0;
}

QFrame#SettingsSection {
  background: @SURFACE@;
  border: 1px solid @BORDER@;
  border-radius: @RADIUS@;
}

QWidget#HeaderBrand, QWidget#HeaderMeta, QWidget#HeaderContext, QFrame#HeaderActions {
  background: transparent;
  border: none;
}

QWidget#SidebarPanel {
  background: @SURFACE@;
  border: none;
  border-right: 1px solid @BORDER@;
  border-radius: 0;
}

QFrame#DeckPanel {
  background: @BACKGROUND@;
  border: none;
  border-radius: 0;
}

QWidget#InspectorPanel {
  background: @SURFACE@;
  border: none;
  border-left: 1px solid @BORDER@;
  border-radius: 0;
}

QScrollArea, QScrollArea#InspectorScroll, QScrollArea#SidebarScroll, QScrollArea#GridScroll,
QScrollArea#SettingsScroll {
  background: transparent;
  border: none;
}

QScrollArea#InspectorScroll > QWidget > QWidget {
  background: @SURFACE@;
}

QScrollArea#SidebarScroll > QWidget > QWidget, QScrollArea#SettingsScroll > QWidget > QWidget {
  background: transparent;
}

QSplitter#WorkspaceSplitter::handle {
  background: transparent;
  width: 5px;
}

QSplitter#WorkspaceSplitter::handle:hover {
  background: @ACCENT_DARK@;
  border-radius: 0;
}

QLabel#HeaderTitle {
  color: @TEXT_STRONG@;
  font-size: 14pt;
  font-weight: 700;
}

QLabel#HeaderSubtitle, QLabel#PanelHint, QLabel#ThemeDescription, QLabel#SettingsDescription,
QLabel#ActionDescription, QLabel#MutedText {
  color: @MUTED@;
  font-size: 9pt;
}

QLabel#HeaderActiveDeck {
  color: @TEXT@;
  font-size: 9pt;
  font-weight: 700;
}

QLabel#HeaderModeChip {
  background: @CHIP@;
  border: 1px solid @BORDER_STRONG@;
  border-radius: @RADIUS_SM@;
  color: @TEXT@;
  font-size: 8pt;
  font-weight: 700;
  padding: 4px 9px;
}

QLabel#HeaderModeChip[state="simulation"] {
  border-color: @WARNING@;
  color: @WARNING@;
}

QLabel#HeaderModeChip[state="connected"] {
  border-color: @SUCCESS@;
  color: @SUCCESS@;
}

QLabel#PanelTitle, QLabel#SettingsTitle {
  color: @TEXT_STRONG@;
  font-size: 13pt;
  font-weight: 700;
}

QLabel#SectionTitle {
  color: @ACCENT@;
  font-size: 9pt;
  font-weight: 700;
  margin-top: 8px;
}

QLabel#FieldLabel {
  color: @TEXT@;
  font-size: 9pt;
  font-weight: 600;
}

QLabel#HotkeyPreview {
  color: @ACCENT@;
  font-size: 9pt;
  font-weight: 700;
  padding: 1px 2px 0 2px;
}

QMenuBar {
  background: @BACKGROUND@;
  color: @TEXT@;
  border-bottom: 1px solid @BORDER@;
  padding: 3px 8px;
}

QMenuBar::item {
  background: transparent;
  border-radius: @RADIUS_SM@;
  padding: 5px 10px;
}

QMenuBar::item:selected, QMenu::item:selected {
  background: @HOVER@;
}

QMenu {
  background: @MENU@;
  color: @TEXT@;
  border: 1px solid @BORDER_STRONG@;
  padding: 6px;
}

QMenu::item {
  border-radius: @RADIUS_SM@;
  padding: 7px 24px;
}

QMenu::separator {
  background: @BORDER@;
  height: 1px;
  margin: 5px 8px;
}

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QListWidget, QTableWidget {
  background: @INPUT@;
  color: @TEXT@;
  border: 1px solid @BORDER@;
  border-radius: @RADIUS_SM@;
  min-height: 20px;
  padding: 7px 9px;
  selection-background-color: @ACCENT@;
  selection-color: @ACCENT_TEXT@;
}

QSpinBox, QDoubleSpinBox {
  padding-right: 30px;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
  background: @PANEL@;
  border: none;
  border-left: 1px solid @BORDER@;
  width: 24px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
  border-top-right-radius: 5px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
  border-bottom-right-radius: 5px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
  background: @HOVER@;
}

QComboBox#HeaderContextCombo {
  min-height: 18px;
  padding: 5px 28px 5px 9px;
}

QComboBox#DeckPageCombo {
  min-height: 18px;
  padding: 5px 28px 5px 10px;
  font-weight: 700;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QListWidget:focus, QTableWidget:focus {
  border: 1px solid @ACCENT@;
}

QPlainTextEdit[invalid="true"], QLineEdit[invalid="true"] {
  border: 1px solid @ERROR@;
}

QComboBox QLineEdit {
  background: transparent;
  border: none;
  border-radius: 0;
  min-height: 0;
  padding: 0;
}

QComboBox::drop-down {
  border: none;
  width: 24px;
}

QComboBox QAbstractItemView {
  background: @MENU@;
  color: @TEXT@;
  border: 1px solid @BORDER_STRONG@;
  outline: none;
  selection-background-color: @HOVER@;
  selection-color: @TEXT_STRONG@;
  padding: 4px;
}

QListWidget#ThemeList::item {
  border: 1px solid transparent;
  border-radius: @RADIUS_SM@;
  margin: 2px;
  padding: 9px;
}

QListWidget#ThemeList::item:hover {
  background: @HOVER@;
}

QListWidget#ThemeList::item:selected {
  background: @CHIP@;
  border-color: @ACCENT@;
  color: @TEXT_STRONG@;
}

QTabWidget::pane {
  background: @SURFACE@;
  border: 1px solid @BORDER@;
  border-radius: @RADIUS_SM@;
  top: -1px;
}

QTabBar::tab {
  background: @PANEL@;
  border: 1px solid @BORDER@;
  color: @MUTED@;
  min-width: 92px;
  padding: 9px 16px;
}

QTabBar::tab:first {
  border-top-left-radius: @RADIUS_SM@;
}

QTabBar::tab:last {
  border-top-right-radius: @RADIUS_SM@;
}

QTabBar::tab:selected {
  background: @SURFACE@;
  color: @TEXT_STRONG@;
  border-bottom-color: @SURFACE@;
}

QTableWidget {
  gridline-color: @BORDER@;
  alternate-background-color: @PANEL@;
}

QHeaderView::section {
  background: @PANEL@;
  border: none;
  border-bottom: 1px solid @BORDER@;
  color: @TEXT@;
  font-weight: 700;
  padding: 7px 8px;
}

QPushButton {
  background: @PANEL@;
  border: 1px solid @BORDER_STRONG@;
  border-radius: @RADIUS_SM@;
  color: @TEXT@;
  font-weight: 600;
  min-height: 20px;
  padding: 7px 12px;
}

QPushButton:hover {
  background: @HOVER@;
  border-color: @ACCENT@;
}

QPushButton:pressed {
  background: @PRESSED@;
}

QPushButton:disabled {
  background: @SURFACE@;
  border-color: @BORDER@;
  color: @PLACEHOLDER@;
}

QPushButton#PrimaryButton, QPushButton#HeaderPrimaryButton {
  background: @ACCENT@;
  border-color: @ACCENT@;
  color: @ACCENT_TEXT@;
  font-weight: 700;
}

QPushButton#PrimaryButton:hover, QPushButton#HeaderPrimaryButton:hover {
  background: @ACCENT_HOVER@;
  border-color: @ACCENT_HOVER@;
}

QPushButton#SecondaryButton, QPushButton#HeaderButton, QPushButton#CategoryButton {
  background: @PANEL@;
  border-color: @BORDER@;
  color: @TEXT@;
}

QPushButton#HeaderButton, QPushButton#HeaderPrimaryButton {
  min-height: 18px;
  padding: 6px 9px;
}

QPushButton#DeckNavButton {
  background: @PANEL@;
  border: 1px solid @BORDER@;
  border-radius: @RADIUS_SM@;
  min-width: 30px;
  max-width: 30px;
  min-height: 30px;
  max-height: 30px;
  padding: 0 0 1px 0;
  font-size: 12pt;
  font-weight: 700;
}

QPushButton#DeckNavButton:hover {
  background: @HOVER@;
  border-color: @ACCENT@;
}

QPushButton#CategoryButton {
  border-radius: @RADIUS_SM@;
  min-height: 18px;
  padding: 5px 10px;
}

QPushButton#CategoryButton:checked {
  background: @ACCENT@;
  border-color: @ACCENT@;
  color: @ACCENT_TEXT@;
}

QCheckBox {
  spacing: 8px;
}

QCheckBox::indicator {
  background: @INPUT@;
  border: 1px solid @BORDER_STRONG@;
  border-radius: @RADIUS_SM@;
  width: 17px;
  height: 17px;
}

QCheckBox::indicator:checked {
  background: @ACCENT@;
  border-color: @ACCENT_HOVER@;
}

QSlider::groove:horizontal {
  background: @BORDER@;
  border-radius: 3px;
  height: 6px;
}

QSlider::sub-page:horizontal {
  background: @ACCENT@;
  border-radius: 3px;
}

QSlider::handle:horizontal {
  background: @TEXT_STRONG@;
  border: 2px solid @ACCENT@;
  border-radius: @RADIUS@;
  margin: -5px 0;
  width: 14px;
}

QStatusBar {
  background: @BACKGROUND@;
  color: @MUTED@;
  border-top: 1px solid @BORDER@;
}

QStatusBar QLabel {
  background: transparent;
  color: @MUTED@;
  padding: 0 6px;
}

QScrollBar:vertical, QScrollBar:horizontal {
  background: transparent;
  border: none;
  margin: 0;
}

QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: @SCROLL@;
  border-radius: @RADIUS_SM@;
  min-height: 24px;
  min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
  background: @ACCENT@;
}

QScrollBar::add-line, QScrollBar::sub-line {
  width: 0;
  height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
  background: transparent;
}

QToolTip {
  background: @MENU@;
  color: @TEXT_STRONG@;
  border: 1px solid @BORDER_STRONG@;
  padding: 5px 7px;
}

QPushButton#DangerButton {
  background: @PANEL@;
  border-color: @BORDER@;
  color: @ERROR@;
}

QPushButton#DangerButton:hover {
  background: @HOVER@;
  border-color: @ERROR@;
}

QPushButton#FilterChip {
  background: transparent;
  border: 1px solid @BORDER@;
  border-radius: 14px;
  padding: 5px 14px;
  color: @MUTED@;
}

QPushButton#FilterChip:checked {
  background: @CHIP@;
  border-color: @ACCENT@;
  color: @TEXT_STRONG@;
}

QFrame#AnimationCard {
  background: @SURFACE@;
  border: 1px solid @BORDER@;
  border-radius: @RADIUS_LG@;
}

QFrame#AnimationCard:hover {
  border-color: @BORDER_STRONG@;
}

QFrame#AnimationCard[selected="true"] {
  border: 2px solid @ACCENT@;
  background: @PANEL@;
}

QLabel#AnimationCardTitle {
  color: @TEXT_STRONG@;
  font-weight: 600;
}

QLabel#AnimationCardMeta {
  color: @MUTED@;
  font-size: 9pt;
}

QToolButton#AnimationTool {
  background: @PANEL@;
  border: 1px solid @BORDER@;
  border-radius: @RADIUS_SM@;
  padding: 4px 10px;
  color: @TEXT@;
}

QToolButton#AnimationTool:hover {
  background: @HOVER@;
  border-color: @BORDER_STRONG@;
}

QToolButton#AnimationTool:checked {
  border-color: @ACCENT@;
  color: @ACCENT@;
}

QListWidget#AnimationFrameStrip {
  background: @INPUT@;
  border: 1px solid @BORDER@;
  border-radius: @RADIUS@;
  padding: 6px;
}

QListWidget#AnimationFrameStrip::item:selected {
  background: @CHIP@;
  border: 1px solid @ACCENT@;
  border-radius: @RADIUS_SM@;
  color: @TEXT_STRONG@;
}
